{
  "projectInfo": {
    "name": "Smart Pix VIP Authentication & AI Credits",
    "description": "User authentication, VIP role management, AI render credits, and album annotations for Smart Pix."
  },
  "roles": [
    {
      "name": "admin",
      "description": "System administrator with full access."
    },
    {
      "name": "vip",
      "description": "VIP user who can access premium features like local filtering and AI retouch."
    },
    {
      "name": "user",
      "description": "Standard authenticated user."
    }
  ],
  "collections": [
    {
      "name": "users",
      "description": "User profiles, roles, and AI render credit balances.",
      "documentId": "{userId}",
      "fields": [
        {
          "name": "email",
          "type": "string",
          "description": "User's email address.",
          "required": true
        },
        {
          "name": "displayName",
          "type": "string",
          "description": "User's display name."
        },
        {
          "name": "photoURL",
          "type": "string",
          "description": "User's profile picture URL."
        },
        {
          "name": "role",
          "type": "string",
          "description": "User's role (admin, vip, user). Defaults to user.",
          "required": true
        },
        {
          "name": "credits",
          "type": "number",
          "description": "Available AI render credits."
        },
        {
          "name": "renderCount",
          "type": "number",
          "description": "Total AI renders completed."
        },
        {
          "name": "createdAt",
          "type": "timestamp",
          "description": "When the user was created.",
          "required": true
        }
      ],
      "rules": {
        "read": "true",
        "create": "true",
        "update": "true",
        "delete": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'"
      }
    },
    {
      "name": "topup_orders",
      "description": "PayOS and VietQR credit top-up orders.",
      "documentId": "{orderId}",
      "fields": [
        {
          "name": "orderCode",
          "type": "number",
          "description": "Unique numeric order code.",
          "required": true
        },
        {
          "name": "uid",
          "type": "string",
          "description": "User ID who created the order.",
          "required": true
        },
        {
          "name": "credits",
          "type": "number",
          "description": "Number of AI render credits in package.",
          "required": true
        },
        {
          "name": "amount",
          "type": "number",
          "description": "Payment amount in VND.",
          "required": true
        },
        {
          "name": "status",
          "type": "string",
          "description": "Order status (PENDING, WAITING_APPROVAL, PAID, CANCELLED).",
          "required": true
        }
      ],
      "rules": {
        "read": "true",
        "create": "true",
        "update": "true",
        "delete": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'"
      }
    },
    {
      "name": "render_logs",
      "description": "Audit log of AI photo retouch renders and credit deductions.",
      "documentId": "{logId}",
      "fields": [
        {
          "name": "uid",
          "type": "string",
          "description": "User ID who executed the render.",
          "required": true
        },
        {
          "name": "resolution",
          "type": "string",
          "description": "Render resolution (1K, 2K, 4K).",
          "required": true
        },
        {
          "name": "creditsCost",
          "type": "number",
          "description": "Credits deducted for this render.",
          "required": true
        }
      ],
      "rules": {
        "read": "true",
        "create": "true",
        "update": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'",
        "delete": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'"
      }
    },
    {
      "name": "albums",
      "description": "Album selections, photo annotations, and AI retouched results.",
      "documentId": "{albumId}",
      "fields": [
        {
          "name": "selectedIds",
          "type": "array",
          "description": "List of selected Google Drive photo IDs."
        },
        {
          "name": "annotations",
          "type": "map",
          "description": "Map of fileId to array of stroke annotations and retouch notes."
        },
        {
          "name": "retouched",
          "type": "map",
          "description": "Map of fileId to AI retouched image URLs."
        },
        {
          "name": "updatedAt",
          "type": "timestamp",
          "description": "Timestamp of the last update."
        }
      ],
      "rules": {
        "read": "true",
        "create": "true",
        "update": "true",
        "delete": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'"
      }
    }
  ]
}
