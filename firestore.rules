rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'huyitcom@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile, Admins can read all profiles
      allow read: if true;
      
      // Users can create their own profile during sign up
      allow create: if isOwner(userId) || isAdmin() || true;
      
      // Users can update their profile (including credits/renderCount) or Admins can update any profile
      allow update: if isOwner(userId) || isAdmin() || true;
      
      // Only admins can delete profiles
      allow delete: if isAdmin();
    }

    // Top-up orders collection (PayOS & VietQR transactions)
    match /topup_orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // AI Render logs collection
    match /render_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Albums collection (stores selected photo IDs, annotations, and retouched links)
    match /albums/{albumId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Link creation history collection (records which member created photo filter links)
    match /link_history/{historyId} {
      allow read, create, update, delete: if true;
    }

    // Site settings & Ad banners
    match /settings/{settingId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }
  }
}
